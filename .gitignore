# Dart/Flutter artifacts at any depth. Keep the root pubspec.lock tracked.
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
coverage/
.widget_preview/
**/doc/api/

# IDE and local files. VS Code configuration can be shared.
.idea/
.vscode/
!/.vscode/
/.vscode/*
!/.vscode/settings.json
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.swp

# Local toolchain and runtime files.
.fvm/
*.log
*.log.*
*.pid

# Native build caches and machine-specific configuration.
.gradle/
.cxx/
**/android/local.properties
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/.last_build_id

# Local API-key configuration (use --dart-define-from-file).
config/*.local.json
